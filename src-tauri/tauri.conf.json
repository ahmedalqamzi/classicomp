{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classicomp",
  "version": "0.1.0",
  "identifier": "com.classicomp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Classicomp",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
